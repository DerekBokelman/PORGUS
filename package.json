{
  "name": "agent-company",
  "version": "0.1.0",
  "description": "Slack-connected multi-agent business planning network.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check-providers": "bun scripts/check-free-providers.ts",
    "check-agents": "bun scripts/check-agents.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@slack/bolt": "latest",
    "dotenv": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
