# Create one Slack app per agent from slack-app-manifest.yaml.
SLACK_ARCHITECT_BOT_TOKEN=xoxb-your-architect-bot-token
SLACK_ARCHITECT_APP_TOKEN=xapp-your-architect-app-token
SLACK_ARCHITECT_SIGNING_SECRET=your-architect-signing-secret

SLACK_AUDITOR_BOT_TOKEN=xoxb-your-auditor-bot-token
SLACK_AUDITOR_APP_TOKEN=xapp-your-auditor-app-token
SLACK_AUDITOR_SIGNING_SECRET=your-auditor-signing-secret

SLACK_OPERATOR_BOT_TOKEN=xoxb-your-operator-bot-token
SLACK_OPERATOR_APP_TOKEN=xapp-your-operator-app-token
SLACK_OPERATOR_SIGNING_SECRET=your-operator-signing-secret

SLACK_BREEDER_BOT_TOKEN=xoxb-your-breeder-bot-token
SLACK_BREEDER_APP_TOKEN=xapp-your-breeder-app-token
SLACK_BREEDER_SIGNING_SECRET=your-breeder-signing-secret

SLACK_CHRONICLER_BOT_TOKEN=xoxb-your-chronicler-bot-token
SLACK_CHRONICLER_APP_TOKEN=xapp-your-chronicler-app-token
SLACK_CHRONICLER_SIGNING_SECRET=your-chronicler-signing-secret

# Shared Slack channel for the agent company (optional — auto-join on startup)
SLACK_CHANNEL_ID=C0BEN1R3ZGF
# Which bot listens for human messages (default: architect)
SLACK_INGRESS_AGENT_ID=architect

# --- Free LLM providers (one per agent — see config/agents.yaml) ---
# Architect + Operator → OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_REFERER=http://localhost

# Auditor + Breeder → Groq: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional — if an agent uses Gemini in config/agents.yaml
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Chronicler → Ollama (local, free): https://ollama.com/download
# Run: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Rate limits (ms between real API calls). Gemini free tier ≈ 5 RPM.
LLM_MIN_INTERVAL_MS=13000

# If true, agents fall back to mock when an API key is missing (dev only).
FALLBACK_TO_MOCK=false

DATABASE_PATH=data/agent-company.db

LIVING_SPEND_CEILING_USD=5
LIVING_MAX_HEADCOUNT=10

# Autonomous heartbeat: agents run work cycles on their own without human input.
# Requires SLACK_CHANNEL_ID. Set LIVING_HEARTBEAT=false to make agents purely reactive.
LIVING_HEARTBEAT=true
# Adaptive cadence: run fast while agents are working, back off when idle.
#   LIVING_TICK_MIN_MS = delay between cycles while busy (default 750 = 0.75s)
#   LIVING_TICK_MS     = backoff ceiling once agents go idle (default 90000 = 90s)
# Per-agent daily call limits and the spend ceiling still bound total cost.
LIVING_TICK_MIN_MS=750
LIVING_TICK_MS=90000
